)
summary(fit_cov)
# Covariates + NMWI model
fit_nmwi <- glm(
Healthy ~ NMWI_z + Age10 + Sex + Sampling.Location,
data=cc_overlap,
family=binomial
)
summary(fit_nmwi)
results <- tidy(fit_nmwi,exponentiate=TRUE,conf.int=TRUE) %>%
transmute(
Variable=term,
OR=round(estimate,2),
CI_low=round(conf.low,2),
CI_high=round(conf.high,2),
P_value=format.pval(p.value,digits=3,eps=0.001)
)
results
# Does NMWI improve the model beyond age, sex, and sampling location?
anova(fit_cov,fit_nmwi,test="LRT")
# Unadjusted model: NMWI only
fit_unadj <- glm(
Healthy ~ NMWI_z,
data = cc_overlap,
family = binomial
)
summary(fit_unadj)
# Unadjusted OR and 95% CI
tidy(
fit_unadj,
exponentiate = TRUE,
conf.int = TRUE
) %>%
transmute(
Variable = term,
OR = round(estimate, 2),
CI_low = round(conf.low, 2),
CI_high = round(conf.high, 2),
P_value = format.pval(p.value, digits = 3, eps = 0.001)
)
fit_nmwi <- glm(
Healthy ~ NMWI_z + Age10 + Sex + Sampling.Location,
data=cc_overlap,
family=binomial
)
summary(fit_nmwi)
print(results)
# Adjusted odds ratios and 95% CI
results <- tidy(fit_nmwi,exponentiate=TRUE,conf.int=TRUE) %>%
transmute(
Variable=term,
OR=round(estimate,2),
CI_low=round(conf.low,2),
CI_high=round(conf.high,2),
P_value=format.pval(p.value,digits=3,eps=0.001)
)
results
# Unadjusted model: NMWI only
fit_unadj <- glm(
Healthy ~ NMWI_z,
data = cc_overlap,
family = binomial
)
summary(fit_unadj)
# Unadjusted model: NMWI only
fit_unadj <- glm(
Healthy ~ NMWI_z,
data = cc_overlap,
family = binomial
)
summary(fit_unadj)
results_unadj <- tidy(fit_unadj, exponentiate=TRUE, conf.int=TRUE)
print(results_unadj)
# Covariate only model
fit_cov <- glm(
Healthy ~ Age10 + Sex + Sampling.Location,
data = cc_overlap,
family = binomial
)
lrt_nmwi <- anova(fit_cov,fit_nmwi,test = "LRT")
print(lrt_nmwi)
